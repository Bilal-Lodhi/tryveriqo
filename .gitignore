# ─── Dependencies ───────────────────────────────────────────────
node_modules/

# ─── Build output ───────────────────────────────────────────────
dist/
build/
.dart_tool/
.packages
*.tsbuildinfo

# ─── Environment and credentials (never commit) ─────────────────
# Only the template is tracked. Every secret lives in the environment.
.env
**/.env
*.env
!*.env.example
!*.env.template
!*.env.sample
application_default_credentials.json
*.pem
*.p12
*.pfx

# ─── Test and coverage output ───────────────────────────────────
coverage/
.nyc_output/
test-results/
*.lcov

# ─── Flutter / Dart ─────────────────────────────────────────────
apps/console/.flutter-plugins
apps/console/.flutter-plugins-dependencies

# ─── Local scratch and editor artifacts ─────────────────────────
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ─── Local database volumes (if ever mounted into the tree) ─────
mongo-data/

# ─── Documentation is source, not build output ──────────────────
# The historical repository carried a blanket `*.md` rule that silently kept
# documentation out of version control; four of its own documentation files were
# never committed because of it. Deliberately absent here.
