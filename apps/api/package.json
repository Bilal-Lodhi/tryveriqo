{
  "name": "@assessment/api",
  "version": "0.1.0",
  "private": true,
  "description": "tryveriqo API — assessment generation, candidate sessions, telemetry ingestion and reviewer timelines",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@assessment/mcp-mongodb": "0.1.0",
    "@google/genai": "^2.7.0",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.6.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
