# Reference reverse proxy for the tryveriqo review console.
#
# This file is an envsubst TEMPLATE, processed at container start by the official
# nginx image into /etc/nginx/conf.d/default.conf. `${API_UPSTREAM}` and
# `${ASSESSMENT_API_TOKEN}` are substituted from the environment; nginx's own
# runtime variables (`$host`, `$remote_addr`, ...) are left alone, because
# envsubst is invoked with only the variables that exist in the environment.
#
# API_UPSTREAM is a full origin WITHOUT a trailing slash, e.g.
#   http://api:8080            (the compose service name)
#   https://api.internal:8080
# A trailing slash would make nginx replace the matched path prefix instead of
# forwarding it, so `/api/v1/sessions` would arrive as `/v1/sessions`.
#
# The console must be built WITHOUT --dart-define=API_TOKEN and with
# API_BASE_URL pointing at this proxy's public origin.
#
# See README.md in this directory, including what this does NOT protect.

server {
  listen 8080;
  server_name _;

  # ── The console's static build ────────────────────────────────────────
  # Served exactly as built. No credential is injected here: a page must never
  # receive one.
  root /usr/share/nginx/html;
  index index.html;

  # Flutter web uses client-side routing; unknown paths fall back to the app.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # The service worker must not be cached, or a deployed console can keep
  # serving a stale build.
  location = /flutter_service_worker.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }
  location = /manifest.json {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # ── The API, with the credential added server-side ────────────────────
  location /api/ {
    # No trailing path, so the original request URI is forwarded unchanged.
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The whole point: the browser never holds this. A client-supplied
    # Authorization header is overwritten rather than forwarded, so a caller
    # cannot substitute their own credential.
    proxy_set_header Authorization "Bearer ${ASSESSMENT_API_TOKEN}";

    # Keep this in step with the API's own ingestion ceiling, so an oversized
    # request is refused here with the same status rather than looking like an
    # API bug.
    client_max_body_size 8m;
  }

  # Proxied so the console's status indicator reflects the API, not the proxy.
  location = /health {
    proxy_pass ${API_UPSTREAM}/health;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
  }

  location ~ /\. {
    deny all;
  }
}
