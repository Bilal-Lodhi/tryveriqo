# ═══════════════════════════════════════════════════════════════════════════════
# Assessment integrity platform — environment template
#
#   cp .env.example .env
#   docker compose up --build
#
# No real credential belongs in this file, and none is provided. Development
# mode generates ephemeral credentials for you and prints the operator token
# once at startup; production refuses to start until every required value is set.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Runtime mode ─────────────────────────────────────────────────────────────
# development : ephemeral credentials are generated and logged; relaxed defaults
# production  : every secret below is mandatory, and startup fails closed
ENVIRONMENT=development

# ─── Networking ───────────────────────────────────────────────────────────────
# Host port the API is published on.
API_PORT=8080
# Host port MongoDB is published on (for mongosh / Compass inspection).
MONGO_PORT=27017

# ─── Datastore ────────────────────────────────────────────────────────────────
# Inside Compose this points at the bundled MongoDB service. Point it at Atlas
# or any other deployment to run against an external database.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=assessment

# ─── MCP tool transport ───────────────────────────────────────────────────────
# The API reaches the MCP tool surface over HTTP. Inside Compose the hostname is
# the service name; for a local non-Docker run use http://127.0.0.1:3001.
MCP_SERVER_ENDPOINT=http://mcp:3001
MCP_TIMEOUT_MS=5000
# Shared token for the tool surface. REQUIRED when ENVIRONMENT=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=

# ─── Authentication ───────────────────────────────────────────────────────────
# Operator (reviewer/console) credential. Grants assessment generation and every
# reviewer surface. REQUIRED when ENVIRONMENT=production.
ASSESSMENT_API_TOKEN=
# Secret used to sign short-lived candidate session tokens. Must be at least 32
# characters. Rotating it invalidates all outstanding candidate tokens, which is
# the intended way to end every candidate session at once.
ASSESSMENT_SESSION_SECRET=
# Candidate token lifetime, in seconds (default 2 hours).
CANDIDATE_SESSION_TTL_SECONDS=7200

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. Never a wildcard. In production
# this must be set explicitly.
# Example: http://localhost:8080,https://review.example.org
CORS_ALLOWED_ORIGINS=

# ─── AI provider ──────────────────────────────────────────────────────────────
# gemini-api : Gemini Developer API, authenticated with GEMINI_API_KEY (default)
# vertex     : Vertex AI, authenticated with Application Default Credentials and
#              GEMINI_VERTEX_PROJECT / GEMINI_VERTEX_LOCATION
AI_PROVIDER_MODE=gemini-api

# REQUIRED for AI_PROVIDER_MODE=gemini-api. Get one from Google AI Studio.
# Never commit the value.
GEMINI_API_KEY=

# REQUIRED for AI_PROVIDER_MODE=vertex.
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1

# Model identifier. Gemini 2.5 Flash is a stable, low-cost multimodal model.
# The historical `gemini-3-flash-preview` identifier never existed on the public
# API and always fell back; do not reintroduce it.
AI_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=65536
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_MS=90000

# ─── Integrity thresholds ─────────────────────────────────────────────────────
# Session lifetime before a candidate session is considered stale (seconds).
SESSION_TTL_SECONDS=7200
# Paste events in one session before an integrity analysis is triggered.
MAX_PASTE_EVENTS=5
# Keystrokes faster than this are counted as implausible (milliseconds).
MIN_HUMAN_KEYSTROKE_MS=80
# Cosine-similarity threshold reported as a similarity concern (0-1).
PLAGIARISM_THRESHOLD=0.75
# Overall integrity score above which an alert is raised (0-100).
ALERT_SCORE_THRESHOLD=50
